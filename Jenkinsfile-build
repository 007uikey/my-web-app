pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        BUCKET = 'jenkin-war-deployment'
        WAR_NAME = 'myapp.war'
    }

    stages {

        stage('Clone Code') {
            steps {
                git branch: 'main',url: 'https://github.com/007uikey/my-web-app.git'
            }
        }

        stage('Build WAR') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Upload WAR to S3') {
            steps {
                sh '''
                aws s3 cp target/*.war s3://$BUCKET/$WAR_NAME
                '''
            }
        }
    }

    post {
        success {
            echo 'WAR uploaded to S3 successfully'
            
            build job: 'deploy-job'
        }
    }
    
}

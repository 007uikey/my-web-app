pipeline {
    agent { label 'slave' }

    tools {
        maven 'Maven'
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',url: 'https://github.com/007uikey/my-web-app.git'
            }
        }

        stage('Build WAR') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy WAR') {
            steps {
                sh '''
                sudo cp target/*.war /mnt/server/apache-tomcat-10.1.54/webapps/myapp.war
                '''
            }
        }

    }
}
